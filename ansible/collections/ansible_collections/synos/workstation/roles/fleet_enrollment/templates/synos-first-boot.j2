#!/bin/sh
# Generated by synos.workstation.fleet_enrollment. Runs once, then marks itself done.
set -eu
mkdir -p /var/lib/synos
if [ -n "${PULL_URL:-}" ]; then
    ansible-pull -U "$PULL_URL" -C "${PULL_BRANCH:-main}" -i localhost, "${PLAYBOOK:-site.yml}"
fi
if [ -n "${INVENTORY_URL:-}" ]; then
    curl -fsS -X POST "$INVENTORY_URL" \
        -H 'Content-Type: application/json' \
        -d "{\"hostname\":\"$(hostname)\",\"machine_id\":\"$(cat /etc/machine-id)\",\"os\":\"$(. /etc/os-release; echo "$ID $VERSION_ID")\"}" || true
fi
date -u +%FT%TZ > /var/lib/synos/first-boot.done
