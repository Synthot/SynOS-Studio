# Generated by synos.workstation.desktop_policy from the profile's
# policy.dconf. Each key names a GSettings schema and key, either already
# as a dconf path ("org/gnome/desktop/lockdown/disable-command-line") or
# as the more familiar dotted GSettings name
# ("org.gnome.desktop.lockdown.disable-command-line") — a key with no "/"
# is treated as dotted and converted; one that already has a "/" is used
# as-is, so both forms render to the same [group]\nkey=value dconf
# keyfile entry.
{% set groups = {} %}
{% for raw_key, value in desktop_policy_dconf.items() %}
{% set key = raw_key if '/' in raw_key else raw_key.replace('.', '/') %}
{% set _ = groups.setdefault(key.rsplit('/', 1)[0], []).append(key.rsplit('/', 1)[1] ~ '=' ~ value) %}
{% endfor %}
{% for path, entries in groups.items() %}
[{{ path }}]
{% for entry in entries %}
{{ entry }}
{% endfor %}
{% endfor %}
