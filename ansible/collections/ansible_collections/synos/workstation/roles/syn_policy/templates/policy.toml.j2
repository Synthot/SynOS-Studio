# Generated by synos.workstation.syn_policy from the profile's policy.ai
# (contract C8). Read by syn-core's Policy::load; the keys mirror policy.ai.
enabled = {{ 'true' if syn_policy_enabled else 'false' }}
providers = [{% for p in syn_policy_providers %}"{{ p }}"{% if not loop.last %}, {% endif %}{% endfor %}]
local_only = {{ 'true' if syn_policy_local_only else 'false' }}
tools_denied = [{% for t in syn_policy_tools_denied %}"{{ t }}"{% if not loop.last %}, {% endif %}{% endfor %}]
memory = "{{ syn_policy_memory }}"
{% if syn_policy_facts %}
facts = "{{ syn_policy_facts }}"
{% endif %}
