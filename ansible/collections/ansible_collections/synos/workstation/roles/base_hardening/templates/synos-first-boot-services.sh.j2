#!/bin/sh
# Generated by the synos.workstation.base_hardening role. Runs once, on the
# first boot of an installed system (never in the live session): enables the
# services the profile asked for and opens their ports in the firewall.
set -u
{% if base_hardening_ssh == 'enabled' %}
systemctl enable --now ssh.service 2>/dev/null || systemctl enable --now sshd.service || echo "synos: could not enable the SSH server" >&2
{% endif %}
{% for port in base_hardening_open_ports %}
command -v ufw >/dev/null 2>&1 && ufw allow {{ port }} >/dev/null || true
{% endfor %}
mkdir -p /var/lib/synos && touch /var/lib/synos/first-boot-services.done
