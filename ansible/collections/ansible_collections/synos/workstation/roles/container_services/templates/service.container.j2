# {{ item.name }}: generated by synos.workstation.container_services from the profile.
# podman quadlet unit; the image is pulled on first start (network needed once).
[Unit]
Description={{ item.description | default(item.name) }}
After=network-online.target{% if container_services_gpu == 'nvidia' and item.gpu | default(false) %} synos-nvidia-cdi.service{% endif %}

Wants=network-online.target
# This is one of the profile's own appliance services, never something the
# base or desktop group needs: an installed system starts it normally, but
# the live session (every live boot carries rd.synos.live=1) is deliberately
# passwordless, so it must never stand this container up on an
# unauthenticated machine. See docs/ARCHITECTURE.md, "Live session vs.
# installed system".
ConditionKernelCommandLine=!rd.synos.live

[Container]
ContainerName={{ item.name }}
Image={{ item.image }}
{% for port in item.ports | default([]) %}
PublishPort={{ port }}
{% endfor %}
{% for volume in item.volumes | default([]) %}
Volume={{ volume }}
{% endfor %}
{% for cap in item.cap_add | default([]) %}
AddCapability={{ cap }}
{% endfor %}
{% if item.exec | default('') %}
Exec={{ item.exec }}
{% endif %}
{% for key, value in (item.env | default({})).items() %}
Environment={{ key }}={{ value }}
{% endfor %}
{% if item.env_file | default('') %}
EnvironmentFile={{ item.env_file }}
{% endif %}
{% if item.gpu | default(false) %}
{% if container_services_gpu == 'nvidia' %}
AddDevice=nvidia.com/gpu=all
{% elif container_services_gpu == 'amd' %}
AddDevice=/dev/kfd
AddDevice=/dev/dri
GroupAdd=keep-groups
{% elif container_services_gpu == 'intel' %}
AddDevice=/dev/dri
GroupAdd=keep-groups
{% endif %}
{% endif %}

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target default.target
