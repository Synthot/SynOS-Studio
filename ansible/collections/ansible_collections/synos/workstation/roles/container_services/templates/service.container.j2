# {{ item.name }}: generated by synos.workstation.container_services from the profile.
# podman quadlet unit; the image is pulled on first start (network needed once).
[Unit]
Description={{ item.description | default(item.name) }}
After=network-online.target{% if container_services_gpu == 'nvidia' and item.gpu | default(false) %} synos-nvidia-cdi.service{% endif %}

Wants=network-online.target

[Container]
ContainerName={{ item.name }}
Image={{ item.image }}
{% for port in item.ports | default([]) %}
PublishPort={{ port }}
{% endfor %}
{% for volume in item.volumes | default([]) %}
Volume={{ volume }}
{% endfor %}
{% if item.exec | default('') %}
Exec={{ item.exec }}
{% endif %}
{% for key, value in (item.env | default({})).items() %}
Environment={{ key }}={{ value }}
{% endfor %}
{% if item.gpu | default(false) %}
{% if container_services_gpu == 'nvidia' %}
AddDevice=nvidia.com/gpu=all
{% elif container_services_gpu == 'amd' %}
AddDevice=/dev/kfd
AddDevice=/dev/dri
GroupAdd=keep-groups
{% elif container_services_gpu == 'intel' %}
AddDevice=/dev/dri
GroupAdd=keep-groups
{% endif %}
{% endif %}

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target default.target
