# Ubuntu base adapter
DESCRIPTION="Canonical. 5 years of support, 10 with Ubuntu Pro; FIPS available. Snap removed."
BASE_ID=ubuntu
BASE_FAMILY=deb
BOOTSTRAP_TOOL=debootstrap
DEFAULT_SUITE=noble
SUPPORTED_SUITES="jammy noble resolute"
APT_MIRROR="http://archive.ubuntu.com/ubuntu/"
SECURITY_MIRROR="http://security.ubuntu.com/ubuntu/"
SNAPSHOT_MIRROR="https://snapshot.ubuntu.com/ubuntu/"
SNAPSHOT_SECURITY_MIRROR="https://snapshot.ubuntu.com/ubuntu/"
COMPONENTS="main restricted universe multiverse"
KEYRING=/usr/share/keyrings/ubuntu-archive-keyring.gpg
KERNEL_PACKAGE=linux-generic
GRUB_SIGNED_PACKAGES="grub-efi-amd64-signed shim-signed"
