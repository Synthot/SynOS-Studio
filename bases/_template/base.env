# Debian base adapter
DESCRIPTION="Describe this base for the configurator."
BASE_ID=debian
BASE_FAMILY=deb
BOOTSTRAP_TOOL=debootstrap
DEFAULT_SUITE=trixie
# Every suite this base can bootstrap and package for at all. If one of them
# cannot back a Live image (no package on it provides the dracut modules
# mods/stack.sh's ensure_dracut_live_modules() requires), do not drop it from
# here or list it separately — declare the gap and its reason in this
# folder's live.map instead (see live.map's own comment, and
# bases/ubuntu/live.map's jammy entry for a real one); a suite absent from
# live.map is assumed to back a Live image fine.
SUPPORTED_SUITES="bookworm trixie"
APT_MIRROR="http://deb.debian.org/debian/"
SECURITY_MIRROR="http://security.debian.org/debian-security/"
SNAPSHOT_MIRROR="https://snapshot.debian.org/archive/debian/"
SNAPSHOT_SECURITY_MIRROR="https://snapshot.debian.org/archive/debian-security/"
COMPONENTS="main contrib non-free non-free-firmware"
KEYRING=/usr/share/keyrings/debian-archive-keyring.gpg
KERNEL_PACKAGE=linux-image-${ARCH}
GRUB_SIGNED_PACKAGES="grub-efi-amd64-signed shim-signed"
