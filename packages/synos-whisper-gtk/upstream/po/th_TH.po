msgstr "ปิด"

#: data/voice-typing@synos.com/extension.js:544
msgid "Voice typing is disabled in password fields"
msgstr "การพิมพ์ด้วยเสียงถูกปิดใช้งานในช่องรหัสผ่าน"

#: data/voice-typing@synos.com/extension.js:549
