#: src/synos_whisper_gtk/app.py:91
msgid "Settings"
msgstr "Definições"

#: src/synos_whisper_gtk/app.py:98
msgid ""
"Use the keyboard shortcut to dictate into the focused application. Speech is"
" processed locally and is never uploaded."
msgstr ""
"Utilize o atalho de teclado para ditar na aplicação em foco. A fala é "
"processada neste computador e nunca é enviada."

#: src/synos_whisper_gtk/app.py:103
msgid "Status"
msgstr "Estado"

#: src/synos_whisper_gtk/app.py:103
msgid "Checking the local service…"
msgstr "A verificar o serviço local…"

