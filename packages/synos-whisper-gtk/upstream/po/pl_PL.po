msgstr "Wybierz pole tekstowe przed dyktowaniem"

#: synos-whisper-framework/data/com.synos.voice-typing.gschema.xml:34
msgid "Briefly preview recognized text before inserting it"
msgstr "Krótko podglądaj rozpoznany tekst przed jego wstawieniem"

#: data/com.synos.VoiceTyping.Settings.desktop:3
msgid "Configure offline system-wide dictation"
msgstr "Konfiguruj systemowe dyktowanie głosowe działające offline"

#: synos-whisper-framework/data/com.synos.voice-typing.gschema.xml:26
msgid "Enable exact-match punctuation and layout commands"
msgstr ""
"Włącz polecenia interpunkcyjne i formatowania tekstu wymagające dokładnego "
"dopasowania"

#: synos-whisper-framework/data/com.synos.voice-typing.gschema.xml:6
