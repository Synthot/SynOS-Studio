msgid "Start"
msgstr "Rozpocznij"

#: src/synos_whisper_gtk/app.py:116
msgid "Input"
msgstr "Wejście"

#: src/synos_whisper_gtk/app.py:117
msgid "System default"
msgstr "Domyślny mikrofon systemowy"

#: src/synos_whisper_gtk/app.py:120
msgid "Microphone"
msgstr "Mikrofon"

#: src/synos_whisper_gtk/app.py:131
msgid "Language"
msgstr "Język"

#: src/synos_whisper_gtk/app.py:142
msgid "Behavior"
msgstr "Zachowanie"

#: src/synos_whisper_gtk/app.py:144
msgid "Keyboard shortcut"
msgstr "Skrót klawiszowy"

#: src/synos_whisper_gtk/app.py:145
msgid "Activate voice typing from anywhere"
msgstr "Aktywuj dyktowanie głosowe z dowolnego miejsca"

#: src/synos_whisper_gtk/app.py:149
msgid "Disabled"
msgstr "Wyłączone"

#: src/synos_whisper_gtk/app.py:153
msgid "Change…"
msgstr "Zmień…"

#: src/synos_whisper_gtk/app.py:164
msgid "Automatic punctuation"
msgstr "Automatyczna interpunkcja"

#: src/synos_whisper_gtk/app.py:165
msgid "Keep punctuation recognized from speech"
msgstr "Zachowuj interpunkcję rozpoznaną z mowy"

#: src/synos_whisper_gtk/app.py:169
msgid "Voice commands"
msgstr "Polecenia głosowe"

#: src/synos_whisper_gtk/app.py:170
msgid "Recognize commands such as “new line” and “comma”"
msgstr "Rozpoznawaj polecenia, takie jak „nowa linia” i „przecinek”"

#: src/synos_whisper_gtk/app.py:174
msgid "Live transcription"
msgstr "Transkrypcja w czasie rzeczywistym"

#: src/synos_whisper_gtk/app.py:175
msgid "Show words in the microphone bar while you speak"
msgstr "Wyświetla słowa na pasku mikrofonu podczas mówienia"

#: src/synos_whisper_gtk/app.py:179
msgid "Final result preview"
msgstr "Podgląd końcowego wyniku"

#: src/synos_whisper_gtk/app.py:180
msgid "Pause briefly before inserting the completed phrase"
msgstr "Poczekaj chwilę przed wstawieniem ukończonej frazy"

#: src/synos_whisper_gtk/app.py:184
msgid "Start and stop sounds"
msgstr "Dźwięki rozpoczęcia i zakończenia"

#: src/synos_whisper_gtk/app.py:185
msgid "Play a subtle microphone cue"
msgstr "Odtwarzaj subtelny sygnał dźwiękowy mikrofonu"

#: src/synos_whisper_gtk/app.py:195
msgid "Models"
msgstr "Modele"

#: src/synos_whisper_gtk/app.py:198
msgid "Offline speech models"
msgstr "Modele rozpoznawania mowy działające offline"

#: src/synos_whisper_gtk/app.py:200
msgid ""
"The Base multilingual model is installed with Voice Typing. Optional models "
"are verified before use."
msgstr ""
"Wielojęzyczny model Base jest zainstalowany wraz z dyktowaniem głosowym. "
"Opcjonalne modele są weryfikowane przed użyciem."

#: src/synos_whisper_gtk/app.py:213
msgid "Remove downloaded model"
msgstr "Usuń pobrany model"

#: src/synos_whisper_gtk/app.py:216
#, python-format
msgid "Remove %s"
msgstr "Usuń %s"

#: src/synos_whisper_gtk/app.py:230
msgid "Microphone Training"
msgstr "Kalibracja mikrofonu"

#: src/synos_whisper_gtk/app.py:234
msgid "Calibrate your speaking setup"
msgstr "Skalibruj warunki dyktowania"

#: src/synos_whisper_gtk/app.py:236
msgid ""
"Whisper does not need a personal voice profile. Use this page to check "
"microphone level, distance, and background noise."
msgstr ""
"Whisper nie wymaga indywidualnego profilu głosu. Na tej stronie możesz "
"sprawdzić poziom sygnału mikrofonu, odległość od mikrofonu i szum tła."

#: src/synos_whisper_gtk/app.py:242
msgid "Practice phrase"
msgstr "Fraza ćwiczeniowa"

#: src/synos_whisper_gtk/app.py:243
msgid "“Voice typing makes writing faster and more accessible.”"
msgstr ""
"„Dyktowanie głosowe sprawia, że pisanie jest szybsze i bardziej dostępne.”"

#: src/synos_whisper_gtk/app.py:249
msgid "Input level"
msgstr "Poziom sygnału wejściowego"

#: src/synos_whisper_gtk/app.py:250
msgid "Speak normally; aim for the middle of the meter"
msgstr ""
"Mów normalnie; staraj się utrzymać poziom sygnału wejściowego w pobliżu "
"środka miernika"

#: src/synos_whisper_gtk/app.py:254
msgid "Microphone input level"
msgstr "Poziom sygnału wejściowego mikrofonu"

#: src/synos_whisper_gtk/app.py:260
msgid "Microphone test"
msgstr "Test mikrofonu"

#: src/synos_whisper_gtk/app.py:261
msgid "No audio is saved during this test"
msgstr "Podczas tego testu nie zapisuje się dźwięku"

#: src/synos_whisper_gtk/app.py:263 src/synos_whisper_gtk/app.py:559
msgid "Start Test"
msgstr "Rozpocznij test"

#: src/synos_whisper_gtk/app.py:268
msgid "Tips for better recognition"
msgstr "Wskazówki dotyczące lepszego rozpoznawania"

#: src/synos_whisper_gtk/app.py:271
msgid "Speak naturally"
msgstr "Mów naturalnie"

#: src/synos_whisper_gtk/app.py:272
msgid "Use short phrases and pause briefly between sentences"
msgstr "Używaj krótkich fraz i rób krótkie pauzy między zdaniami"

#: src/synos_whisper_gtk/app.py:276
msgid "Reduce background noise"
msgstr "Zmniejsz szum tła"

#: src/synos_whisper_gtk/app.py:277
msgid "Keep the microphone close without speaking directly into it"
msgstr "Trzymaj mikrofon blisko ust, ale nie mów bezpośrednio do mikrofonu"

#: src/synos_whisper_gtk/app.py:281
msgid "Choose the language"
msgstr "Wybierz język"

#: src/synos_whisper_gtk/app.py:282
msgid "A fixed language is faster than automatic detection"
msgstr ""
"Wybranie konkretnego języka jest szybsze niż automatyczne wykrywanie języka"

#: src/synos_whisper_gtk/app.py:305
msgid "Stop"
msgstr "Zatrzymaj"

#: src/synos_whisper_gtk/app.py:343
msgid "Set Keyboard Shortcut"
msgstr "Ustaw skrót klawiszowy"

#: src/synos_whisper_gtk/app.py:365
msgid "Press the new shortcut"
msgstr "Naciśnij nowy skrót klawiszowy"

#: src/synos_whisper_gtk/app.py:369
msgid "The keys you press will be used to start or stop Voice Typing."
msgstr ""
"Naciśnięte klawisze zostaną użyte do rozpoczęcia lub zatrzymania dyktowania "
"głosowego."

#: src/synos_whisper_gtk/app.py:377
msgid "Waiting for input…"
msgstr "Oczekiwanie na naciśnięcie klawisza…"

#: src/synos_whisper_gtk/app.py:383
msgid "Esc cancels · Backspace disables the shortcut"
msgstr "Esc anuluje · Backspace usuwa skrót klawiszowy"

#: src/synos_whisper_gtk/app.py:445
#, python-format
msgid "Download %s from Hugging Face?"
msgstr "Pobrać %s z Hugging Face?"

#: src/synos_whisper_gtk/app.py:447
msgid ""
"This optional model is hosted by Hugging Face, a third-party service. SynOS is not affiliated with, sponsored by, or partnered with Hugging Face.\n"
"\n"
"If you continue, your computer will connect directly to huggingface.co. Hugging Face will receive your public IP address and that address may reveal your approximate location.\n"
"\n"
"Privacy policy: https://huggingface.co/privacy"
msgstr ""
"Ten opcjonalny model jest hostowany przez Hugging Face, zewnętrzną usługę. SynOS nie jest powiązany z Hugging Face, nie jest przez nią sponsorowany ani nie jest jej partnerem.\n"
"\n"
"Jeśli będziesz kontynuować, Twój komputer połączy się bezpośrednio z huggingface.co. Hugging Face otrzyma Twój publiczny adres IP, który może ujawnić Twoją przybliżoną lokalizację.\n"
"\n"
"Polityka prywatności: https://huggingface.co/privacy"

#: src/synos_whisper_gtk/app.py:456 src/synos_whisper_gtk/app.py:510
msgid "Cancel"
msgstr "Anuluj"

#: src/synos_whisper_gtk/app.py:457
msgid "Continue Download"
msgstr "Kontynuuj pobieranie"

#: src/synos_whisper_gtk/app.py:479 src/synos_whisper_gtk/app.py:538
msgid "Downloading…"
msgstr "Pobieranie…"

#: src/synos_whisper_gtk/app.py:497
msgid "Retry"
msgstr "Spróbuj ponownie"

#: src/synos_whisper_gtk/app.py:498
msgid "Model download failed"
msgstr "Pobieranie modelu nie powiodło się"

#: src/synos_whisper_gtk/app.py:499
msgid "Close"
msgstr "Zamknij"

#: src/synos_whisper_gtk/app.py:507
#, python-format
msgid "Remove %s model?"
msgstr "Usunąć model %s?"

#: src/synos_whisper_gtk/app.py:508
msgid "The model can be downloaded again later."
msgstr "Model będzie można pobrać ponownie później."

#: src/synos_whisper_gtk/app.py:511
msgid "Remove"
msgstr "Usuń"

#: src/synos_whisper_gtk/app.py:547
msgid "In Use"
msgstr "W użyciu"

#: src/synos_whisper_gtk/app.py:550
msgid "Use"
msgstr "Użyj"

#: src/synos_whisper_gtk/app.py:553
msgid "Download"
msgstr "Pobierz"

#: src/synos_whisper_gtk/app.py:559
msgid "Stop Test"
msgstr "Zatrzymaj test"

#: src/synos_whisper_gtk/app.py:593
msgid "SynOS Voice Typing"
msgstr "Dyktowanie głosowe w SynOS"

#: src/synos_whisper_gtk/app.py:595
msgid "SynOS Team"
msgstr "Zespół SynOS"

#: src/synos_whisper_gtk/app.py:597
msgid "Private, offline speech-to-text for the whole desktop."
msgstr ""
"Chroniąca prywatność, działająca offline zamiana mowy na tekst w całym "
"środowisku graficznym."

