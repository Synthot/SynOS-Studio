#!/bin/sh
set -e
# When swap-config is removed, 30-synos-swap.conf (swappiness=100) is gone.
# Reload sysctl so the next-highest-priority file takes over:
#   20-synos-tweaks.conf (swappiness=10) from system-tweaks, or
#   kernel default (60) if system-tweaks is also not installed.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    sysctl --system >/dev/null 2>&1 || true
fi
# systemd units (generated)
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then systemctl disable synos-zram.service >/dev/null 2>&1 || true; fi
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then systemctl disable synos-zswap.service >/dev/null 2>&1 || true; fi
