#: assets/synos-oobe:371
msgid "Disk Snapshots Manager"
msgstr "Διαχείριση στιγμιοτύπων δίσκου"

#: assets/synos-oobe:373
msgid "Protect your system with automatic Btrfs snapshots and smart cleanup."
msgstr ""
"Προστατέψτε το σύστημά σας με αυτόματα στιγμιότυπα Btrfs και έξυπνο "
"καθαρισμό."

#: assets/synos-oobe:375
msgid "Configure Automatic Snapshots"
msgstr "Διαμόρφωση αυτόματων στιγμιότυπων"

#: assets/synos-oobe:380
msgid "System Backup"
msgstr "Αντίγραφα ασφαλείας συστήματος"

#: assets/synos-oobe:382
msgid "Use Deja Dup to protect your"
msgstr "Χρησιμοποιήστε το Deja Dup για να προστατέψετε τα"

#: assets/synos-oobe:383
msgid "important files with automated,"
msgstr "σπουδαία αρχεία με αυτοματοποιημένες,"

#: assets/synos-oobe:384
msgid "secure local or remote backups."
msgstr "ασφαλίσεις τοπικές ή απομακρυσμένες."

#: assets/synos-oobe:386
msgid "Get Deja Dup"
msgstr "Λάβετε το Deja Dup"

#: assets/synos-oobe:443
msgid "NetworkManager could not scan Wi-Fi."
msgstr "Το NetworkManager δεν μπόρεσε να σαρώσει το Wi-Fi."

#: assets/synos-oobe:506
msgid "Could not inspect network adapters."
msgstr "Δεν ήταν δυνατή η επιθεώρηση προσαρμογέων δικτύου."

#: assets/synos-oobe:516
msgid "Could not read the Wi-Fi radio state."
msgstr "Δεν ήταν δυνατή η ανάγνωση της κατάστασης του ραδιοφώνου Wi-Fi."

#: assets/synos-oobe:522
msgid "Unknown Wi-Fi radio state: {}"
msgstr "Άγνωστη κατάσταση ραδιοφώνου Wi-Fi: {}"

#: assets/synos-oobe:523
msgid "empty"
msgstr "αδειάζω"

#: assets/synos-oobe:532
msgid "Could not change the Wi-Fi radio state."
msgstr "Δεν ήταν δυνατή η αλλαγή της κατάστασης του ραδιοφώνου Wi-Fi."

#: assets/synos-oobe:634
msgid "Welcome Home."
msgstr "Καλώς ήρθατε στο σπίτι σας."

#: assets/synos-oobe:644
msgid "SynOS is ready. Just a few steps to shape it"
msgstr "Το SynOS είναι έτοιμο. Απλά λίγα βήματα για να το διαμορφώσετε"

#: assets/synos-oobe:644
msgid "into the perfect system tailored to your habits."
msgstr "στο τέλειο σύστημα προσαρμοσμένο στις συνήθειές σας."

#: assets/synos-oobe:654
msgid "  Start Setup  "
msgstr "  Εκκίνηση ρύθμισης  "

#: assets/synos-oobe:701
msgid "Connect to the Internet"
msgstr "Συνδεθείτε στο Διαδίκτυο"

#: assets/synos-oobe:709
msgid ""
"Connect now so SynOS can safely check for updates, drivers, and apps."
msgstr ""
"Συνδεθείτε τώρα, ώστε το SynOS να μπορεί να ελέγχει με ασφάλεια για "
"ενημερώσεις, προγράμματα οδήγησης και εφαρμογές."

#: assets/synos-oobe:717
msgid "Internet Connection"
msgstr "Σύνδεση στο Διαδίκτυο"

#: assets/synos-oobe:724
msgid "Network Hardware"
msgstr "Υλικό δικτύου"

#: assets/synos-oobe:732
msgid "Available Wi-Fi Networks"
msgstr "Διαθέσιμα δίκτυα Wi-Fi"

#: assets/synos-oobe:734
msgid "Wi-Fi"
msgstr "Wi-Fi"

#: assets/synos-oobe:737
msgid "Scan Again"
msgstr "Σάρωση ξανά"

#: assets/synos-oobe:746 assets/synos-oobe:818 assets/synos-oobe:826
#: assets/synos-oobe:841
msgid "Open Network Settings"
msgstr "Άνοιγμα ρυθμίσεων δικτύου"

#: assets/synos-oobe:755
msgid "Could not open network settings: {}"
msgstr "Δεν ήταν δυνατό το άνοιγμα των ρυθμίσεων δικτύου: {}"

#: assets/synos-oobe:765
msgid "Continue Offline"
msgstr "Συνέχεια εκτός σύνδεσης"

#: assets/synos-oobe:769
msgid "Skip updates, online drivers, apps, and account setup."
msgstr ""
"Παραλείψτε ενημερώσεις, προγράμματα οδήγησης στο διαδίκτυο, εφαρμογές και "
"ρύθμιση λογαριασμού."

#: assets/synos-oobe:785
msgid "Internet connection is ready. Choose Next to continue."
msgstr ""
"Η σύνδεση στο Διαδίκτυο είναι έτοιμη. Επιλέξτε Επόμενο για να συνεχίσετε."

#: assets/synos-oobe:792
msgid "Connect to Wi-Fi or a wired network to continue."
msgstr "Συνδεθείτε σε Wi-Fi ή σε ενσύρματο δίκτυο για να συνεχίσετε."

#: assets/synos-oobe:815
msgid "No network adapters detected."
msgstr "Δεν εντοπίστηκαν προσαρμογείς δικτύου."

#: assets/synos-oobe:817
msgid "Connect a network adapter or continue offline."
msgstr "Συνδέστε έναν προσαρμογέα δικτύου ή συνεχίστε εκτός σύνδεσης."

#: assets/synos-oobe:822
msgid "Wired Network"
msgstr "Ενσύρματο δίκτυο"

#: assets/synos-oobe:824
msgid "Cable connected."
msgstr "Συνδέθηκε καλώδιο."

#: assets/synos-oobe:825
msgid "Plug in a network cable to connect."
msgstr "Συνδέστε ένα καλώδιο δικτύου για να συνδεθείτε."

#: assets/synos-oobe:830
msgid "Wireless Network"
msgstr "Ασύρματο δίκτυο"

#: assets/synos-oobe:831
msgid "Wi-Fi adapter detected."
msgstr "Εντοπίστηκε προσαρμογέας Wi-Fi."

#: assets/synos-oobe:832
msgid "Open Wi-Fi Settings"
msgstr "Άνοιγμα ρυθμίσεων Wi-Fi"

#: assets/synos-oobe:836
msgid "Wired and Wireless Networks"
msgstr "Ενσύρματα και ασύρματα δίκτυα"

#: assets/synos-oobe:838
msgid "Cable connected and Wi-Fi available."
msgstr "Συνδεδεμένο καλώδιο και διαθέσιμο Wi-Fi."

#: assets/synos-oobe:840
msgid "Wi-Fi is available; the network cable is disconnected."
msgstr "Διατίθεται Wi-Fi. το καλώδιο δικτύου είναι αποσυνδεδεμένο."

#: assets/synos-oobe:852
msgid "Wi-Fi is turned off."
msgstr "Το Wi-Fi είναι απενεργοποιημένο."

#: assets/synos-oobe:856
msgid "No Wi-Fi networks found."
msgstr "Δεν βρέθηκαν δίκτυα Wi-Fi."

#: assets/synos-oobe:885
msgid "Wi-Fi unavailable: {}"
msgstr "Το Wi-Fi δεν είναι διαθέσιμο: {}"

#: assets/synos-oobe:967
msgid "Define Your Visual Order"
msgstr "Ορίστε την οπτική σας τάξη"

#: assets/synos-oobe:977
msgid "Light and Shadow"
msgstr "Φως και σκιά"

#: assets/synos-oobe:978
msgid "Choose a crisp light theme, or an immersive dark experience."
msgstr "Επιλέξτε ένα καθαρό φωτεινό θέμα ή μια εμβυθιστική σκοτεινή εμπειρία."

#: assets/synos-oobe:997
msgid "Light"
msgstr "Φωτεινό"

#: assets/synos-oobe:1009
msgid "Dark"
msgstr "Σκοτεινό"

#: assets/synos-oobe:1040
msgid "Workflow Layout"
msgstr "Διάταξη ροής εργασιών"

#: assets/synos-oobe:1041
msgid "Prefer modern centered alignment, or classic left-docked?"
msgstr ""
"Προτιμάτε τη σύγχρονη κεντρική ευθυγράμμιση ή την κλασική αριστερή "
"τοποθέτηση;"

#: assets/synos-oobe:1075
msgid "Taskbar Layout"
msgstr "Διάταξη γραμμής εργασιών"

#: assets/synos-oobe:1076
msgid "Choose your workflow."
msgstr "Επιλέξτε τη ροή εργασιών σας."

#: assets/synos-oobe:1085
msgid " Modern "
msgstr " Σύγχρονο "

#: assets/synos-oobe:1086
msgid " Classic "
msgstr " Κλασικό "

#: assets/synos-oobe:1115
msgid "Show Virtual Desktop Switch Button"
msgstr "Εμφάνιση κουμπιού εναλλαγής εικονικών επιφανειών εργασίας"

#: assets/synos-oobe:1116
msgid "Display the Activities button on the taskbar"
msgstr "Εμφάνιση του κουμπίου Δραστηριότητες στη γραμμή εργασιών"

#: assets/synos-oobe:1168
msgid "Digital Sovereignty, Under Your Control"
msgstr "Ψηφιακή κυριαρχία, υπό τον έλεγχό σας"

#: assets/synos-oobe:1176
msgid "We deeply value privacy. Here, you hold absolute authority."
msgstr ""
"Αξιολογούμε βαθιά την ιδιωτικότητα. Εδώ, εσείς κατέχετε απόλυτη εξουσία."

#: assets/synos-oobe:1186
msgid "Network Security"
msgstr "Ασφάλεια δικτύου"

#: assets/synos-oobe:1188
msgid ""
"Control inbound protection and whether this computer participates in local "
"network discovery."
msgstr ""
"Ελέγξτε την προστασία εισερχόμενων και εάν αυτός ο υπολογιστής συμμετέχει "
"στην ανακάλυψη τοπικού δικτύου."

#: assets/synos-oobe:1193
msgid "Network Firewall (UFW)"
msgstr "Τείχος προστασίας δικτύου (UFW)"

#: assets/synos-oobe:1246
msgid "Local Network Discovery (mDNS)"
msgstr "Ανακάλυψη τοπικού δικτύου (mDNS)"

#: assets/synos-oobe:1248
msgid ""
"Find printers and nearby devices, and make .local names available on trusted"
" networks."
msgstr ""
"Βρείτε εκτυπωτές και κοντινές συσκευές και κάντε διαθέσιμα ονόματα .τοπικά "
"σε αξιόπιστα δίκτυα."

#: assets/synos-oobe:1260
msgid "Local network discovery controls are not installed."
msgstr ""
"Τα στοιχεία ελέγχου εντοπισμού τοπικού δικτύου δεν έχουν εγκατασταθεί."

#: assets/synos-oobe:1295
msgid "Location Services"
msgstr "Υπηρεσίες τοποθεσίας"

#: assets/synos-oobe:1297
msgid ""
"Allow apps like weather and clock to access your approximate geographic "
"location."
msgstr ""
"Επιτρέψτε σε εφαρμογές όπως καιρός και ρολόι να προσπελάσουν την κατά "
"προσέγγιση γεωγραφική σας θέση."

#: assets/synos-oobe:1301
msgid "Location Access"
msgstr "Πρόσβαση στην τοποθεσία"

#: assets/synos-oobe:1319
msgid "Power Settings"
msgstr "Ρυθμίσεις ισχύος"

#: assets/synos-oobe:1320
msgid "Manage idle behavior to balance energy saving and convenience."
msgstr ""
"Διαχείριση συμπεριφοράς ανενεργότητας για ισορροπία μεταξύ εξοικονόμησης "
"ενέργειας και ευκολίας χρήσης."

#: assets/synos-oobe:1324
msgid "Auto Sleep"
msgstr "Αυτόματη αδρανοποίηση"

#: assets/synos-oobe:1353
msgid "Command-line Assistance"
msgstr "Βοήθεια γραμμής εντολών"

#: assets/synos-oobe:1354
msgid "Control local bash predictions."
msgstr "Ελέγξτε τις τοπικές προβλέψεις bash."

#: assets/synos-oobe:1358
msgid "Bash Command Predictions"
msgstr "Προβλέψεις εντολών Bash"

#: assets/synos-oobe:1359
msgid "Show command suggestions in bash"
msgstr "Εμφάνιση προτάσεων εντολών στο bash"

#: assets/synos-oobe:1376
msgid ""
"Could not update your Bash configuration. Your previous setting was kept."
msgstr ""
"Δεν ήταν δυνατή η ενημέρωση της ρύθμισης Bash. Διατηρήθηκε η προηγούμενη "
"ρύθμιση."

#: assets/synos-oobe:1414
msgid "Keep Your System Up to Date"
msgstr "Διατηρήστε το σύστημά σας ενημερωμένο"

#: assets/synos-oobe:1423
msgid "Security patches and the latest features are just a click away."
msgstr ""
"Oι ενημερώσεις ασφαλείας και οι τελευταίες λειτουργίες είναι μόνο ένα κλικ "
"μακριά."

#: assets/synos-oobe:1433
msgid "Terminal Output"
msgstr "Έξοδος τερματικού"

#: assets/synos-oobe:1470
msgid "  Do It Later  "
msgstr "  Να γίνει αργότερα  "

#: assets/synos-oobe:1473
msgid "  Find Fastest Mirror  "
msgstr "  Εύρεση ταχύτερου διακομιστή λήψης  "

#: assets/synos-oobe:1476
msgid "  Check for Updates  "
msgstr "  Έλεγχος για ενημερώσεις  "

#: assets/synos-oobe:1510
msgid "Checking for updates…"
msgstr "Έλεγχος για ενημερώσεις…"

#: assets/synos-oobe:1542
msgid "Updates are available."
msgstr "Υπάρχουν διαθέσιμες ενημερώσεις."

#: assets/synos-oobe:1543
msgid "  Install Updates  "
msgstr "  Εγκατάσταση ενημερώσεων  "

#: assets/synos-oobe:1550
msgid "✓ System is up to date."
msgstr "✓ Το σύστημα είναι ενημερωμένο."

#: assets/synos-oobe:1552 assets/synos-oobe:1582
msgid "  Continue  "
msgstr "  Συνέχεια  "

#: assets/synos-oobe:1559
msgid "✗ Check failed: "
msgstr "✗ Αποτυχία ελέγχου: "

#: assets/synos-oobe:1565
msgid "Installing updates…"
msgstr "Εγκατάσταση ενημερώσεων…"

#: assets/synos-oobe:1580
msgid "✓ Updates installed successfully!"
msgstr "✓ Οι ενημερώσεις εγκαταστάθηκαν επιτυχώς!"

#: assets/synos-oobe:1591
msgid "✗ Installation failed: "
msgstr "✗ Αποτυχία εγκατάστασης: "

#: assets/synos-oobe:1630
msgid "Testing mirrors…"
msgstr "Δοκιμή καθρεφτών…"

#: assets/synos-oobe:1631
msgid "=== Testing mirror speeds ==="
msgstr "=== Δοκιμή ταχυτήτων κατοπτρών ==="

#: assets/synos-oobe:1756 assets/synos-oobe:1764
#, python-brace-format
msgid "Testing mirrors… ({c}/{t})"
msgstr "Δοκιμή καθρεπτών… ({c}/{t})"

#: assets/synos-oobe:1772
msgid "No mirrors reachable."
msgstr "Κανένα κάτοπτρο δεν είναι προσβάσιμο."

#: assets/synos-oobe:1774
msgid "✗ No mirrors reachable. Check your connection."
msgstr "✗ Δεν υπάρχουν προσβάσιμοι καθρέφτες. Ελέγξτε τη σύνδεσή σας."

#: assets/synos-oobe:1782
msgid "=== Testing bandwidth of top 5 mirrors "
msgstr "=== Δοκιμή_bandwidth κορυφαίων 5 κατόπτρων === "

#: assets/synos-oobe:1783
msgid "(3 s each) ==="
msgstr "(3 δλ το καθένα) ==="

#: assets/synos-oobe:1837
msgid "Best mirror by bandwidth"
msgstr "Καλύτερος καθρέφτης βάσει εύρους ζώνης"

#: assets/synos-oobe:1839 assets/synos-oobe:1860
#: assets/synos-oobe:1867
msgid "Latency"
msgstr "Καθυστέρηση"

#: assets/synos-oobe:1840 assets/synos-oobe:1861
#: assets/synos-oobe:1868
msgid "Bandwidth"
msgstr "Εύρος Ζώνης"

#: assets/synos-oobe:1862
