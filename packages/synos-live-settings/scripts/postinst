#!/bin/sh
set -e
# systemd units (generated)
if [ "$1" = "configure" ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable synos-live-session.service >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then systemctl start synos-live-session.service >/dev/null 2>&1 || true; fi
fi
