#!/bin/sh
set -e
# systemd units (generated)
if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then systemctl stop synos-dracut-migration.service >/dev/null 2>&1 || true; fi
if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then systemctl stop synos-dracut-migration.timer >/dev/null 2>&1 || true; fi
if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then systemctl stop synos-dracut-confirm-boot.service >/dev/null 2>&1 || true; fi
