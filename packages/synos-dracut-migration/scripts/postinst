#!/bin/sh
set -e
# systemd units (generated)
if [ "$1" = "configure" ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable synos-dracut-migration.timer >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then systemctl start synos-dracut-migration.timer >/dev/null 2>&1 || true; fi
fi
if [ "$1" = "configure" ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable synos-dracut-confirm-boot.service >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then systemctl start synos-dracut-confirm-boot.service >/dev/null 2>&1 || true; fi
fi
