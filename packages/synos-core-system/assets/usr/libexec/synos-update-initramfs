#!/bin/sh
set -eu

REAL_UPDATE_INITRAMFS=${SYNOS_UPDATE_INITRAMFS_REAL:-/usr/sbin/update-initramfs.synos-dracut}
VERIFY=${SYNOS_MIGRATION_VERIFY:-/usr/libexec/synos-dracut-verify}

[ -x "$REAL_UPDATE_INITRAMFS" ] || {
    printf '%s\n' 'synos-update-initramfs: diverted Dracut implementation is missing' >&2
    exit 1
}

# dpkg does not order the shared Dracut trigger after pending kernel postinst
# scripts. Both its activation call and its later invocation may therefore run
# before a newly unpacked kernel has an initrd. The packages that add mandatory
# image content perform their own synchronous final verification instead.
maintscript_update=false
if [ "${DPKG_MAINTSCRIPT_PACKAGE+x}" = x ] \
    && [ "$#" -eq 1 ] && [ "$1" = -u ]; then
    maintscript_update=true
fi

delete=false
for argument in "$@"; do
    [ "$argument" != -d ] || delete=true
done

"$REAL_UPDATE_INITRAMFS" "$@"

[ "$maintscript_update" = false ] || exit 0
[ "$delete" = false ] || exit 0
# While updates are switched off (the image build installs packages with
# update_initramfs=no and generates the initrd once at the end), nothing was
# rebuilt, so there is nothing to verify yet.
CONF=${SYNOS_UPDATE_INITRAMFS_CONF:-${DPKG_ROOT:-}/etc/initramfs-tools/update-initramfs.conf}
if [ -r "$CONF" ]; then
    update_initramfs=yes
    # shellcheck disable=SC1090
    . "$CONF"
    [ "${update_initramfs:-yes}" != no ] || exit 0
fi
[ -x "$VERIFY" ] || {
    printf '%s\n' 'synos-update-initramfs: synchronous verifier is missing' >&2
    exit 1
}
"$VERIFY" --verify
